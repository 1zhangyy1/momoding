diff --git a/src/tracee/event.c b/src/tracee/event.c
index 503ba65..ce6c0b9 100644
--- a/src/tracee/event.c
+++ b/src/tracee/event.c
@@ -96,6 +96,25 @@ int launch_process(Tracee *tracee, char *const argv[])
 		return -errno;
 
 	case 0: /* child */
+		/* Android app processes inherit ignored signal dispositions from Zygote.
+		 * In particular, ignored SIGPIPE makes ordinary guest pipelines such as
+		 * `yes | head` never terminate. Our ProcessBuilder caller opts into a clean
+		 * command-process signal state before PRoot launches the first tracee. */
+		if (getenv("MOMODING_PROOT_RESET_GUEST_SIGNALS") != NULL) {
+			struct sigaction action;
+			sigset_t empty_set;
+			int signum;
+
+			memset(&action, 0, sizeof(action));
+			action.sa_handler = SIG_DFL;
+			sigemptyset(&action.sa_mask);
+			for (signum = 1; signum < SIGRTMAX; signum++)
+				if (signum != SIGKILL && signum != SIGSTOP)
+					(void) sigaction(signum, &action, NULL);
+			sigemptyset(&empty_set);
+			(void) sigprocmask(SIG_SETMASK, &empty_set, NULL);
+		}
+
 		/* Declare myself as ptraceable before executing the
 		 * requested program. */
 		status = ptrace(PTRACE_TRACEME, 0, NULL, NULL);
@@ -301,6 +320,8 @@ int event_loop()
 	/* Handle all signals.  */
 	for (signum = 0; signum < SIGRTMAX; signum++) {
