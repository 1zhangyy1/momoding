<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="mo_phone_shell_title">進階權限</string>
    <string name="mo_phone_shell_ready">已開：它能改設定、管 App、在看不見的螢幕上操作</string>
    <string name="mo_phone_shell_not_paired">點這裡，開啟「無線偵錯」，點「使用配對碼配對裝置」，把 6 位配對碼填進 Momoding 的通知裡，其餘 Momoding 自己完成</string>
    <string name="mo_phone_shell_off">無線偵錯關了：點這裡重新開啟（不用再配對）</string>
    <string name="mo_phone_shell_unsupported">需要 Android 11 或更新</string>
    <string name="mo_phone_shell_footer">用的是 Android 內建的無線偵錯，手機和自己配對：不用另裝 App，也不用電腦。配一次就好：重啟後多數手機上 Momoding 會自己恢復；沒恢復時回這裡點一下，不用再配對。</string>
    <string name="mo_phone_shell_state_ready">已就緒</string>
    <string name="mo_phone_shell_state_not_paired">還沒設定</string>
    <string name="mo_phone_shell_state_off">無線偵錯關著</string>
    <string name="mo_phone_shell_set_up">去設定</string>
    <string name="mo_phone_pair_watching">在「無線偵錯」裡點「使用配對碼配對裝置」，再把 6 位配對碼填到這裡（點「填配對碼」）</string>
    <string name="mo_phone_pair_not_seen">等太久了，回 Momoding 再試一次</string>
    <string name="mo_phone_pair_done">配好了：進階權限已開</string>
    <string name="mo_phone_pair_failed">配對碼不對或已失效，填現在顯示的那個</string>
    <string name="mo_phone_pair_six_digits">配對碼是 6 位數字，再填一次</string>
    <string name="mo_phone_pair_no_dialog">先別關配對彈窗，開著它再填配對碼</string>
    <string name="mo_phone_pair_code_action">填配對碼</string>
    <string name="mo_phone_pair_code_hint">6 位配對碼</string>
    <string name="mo_phone_pair_enter">把配對彈窗裡的 6 位配對碼填到這裡</string>
    <string name="mo_phone_steps_left">還差 %1$d 步</string>
    <string name="mo_phone_step_dev">開發人員選項</string>
    <string name="mo_phone_step_dev_hint">設定 → 關於手機，連點「版本號碼」7 下</string>
    <string name="mo_phone_step_wireless">無線偵錯</string>
    <string name="mo_phone_step_wireless_hint">打開它；彈窗裡勾「一律允許透過這個網路進行」，再點允許</string>
    <string name="mo_phone_step_pair">配對</string>
    <string name="mo_phone_step_pair_hint">點「使用配對碼配對裝置」，把 6 位配對碼填進 Momoding 的通知</string>
    <string name="mo_phone_step_on">已開啟</string>
    <string name="mo_phone_step_said_on">我已經打開了</string>
    <string name="mo_phone_xiaomi_note">小米 / 紅米：沒開「USB 偵錯（安全設定）」時，進階權限不能替 App 授權（權限卡會帶你去系統窗點一下），其餘照常。打開它要插 SIM 卡並登入小米帳號。</string>
</resources>
