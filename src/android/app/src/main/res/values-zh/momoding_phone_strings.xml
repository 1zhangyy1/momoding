    <string name="mo_phone_shell_state_off">无线调试关着</string>
    <string name="mo_phone_shell_set_up">去设置</string>
    <string name="mo_phone_pair_watching">请点「使用配对码配对设备」，配对码 Momoding 会自己读</string>
    <string name="mo_phone_pair_not_seen">没看到配对弹窗，回 Momoding 再试一次</string>
    <string name="mo_phone_pair_done">配好了：高级权限已开</string>
